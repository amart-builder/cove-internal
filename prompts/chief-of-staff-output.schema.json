{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["journal", "watching", "actions"],
  "properties": {
    "journal": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "watching": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "actions": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "kind",
          "why",
          "title",
          "details",
          "due_at",
          "remind_at",
          "priority",
          "project",
          "status",
          "task_id",
          "contact_id",
          "channel",
          "summary",
          "next_action",
          "next_follow_up_at",
          "notes",
          "stage",
          "content",
          "suggestion_kind",
          "description",
          "reason",
          "due_date",
          "claim_key"
        ],
        "properties": {
          "action_id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "kind": {
            "enum": [
              "task_create",
              "task_update",
              "pipeline_add",
              "pipeline_log_touch",
              "pipeline_update",
              "pipeline_move",
              "crm_note",
              "suggest"
            ]
          },
          "why": { "type": "string", "minLength": 1, "maxLength": 200 },
          "title": { "type": ["string", "null"], "maxLength": 500 },
          "details": { "type": ["string", "null"], "maxLength": 5000 },
          "due_at": { "type": ["string", "null"], "maxLength": 40 },
          "remind_at": { "type": ["string", "null"], "maxLength": 40 },
          "priority": { "enum": ["low", "medium", "high", null] },
          "project": { "type": ["string", "null"], "maxLength": 200 },
          "status": { "enum": ["open", "done", null] },
          "task_id": { "type": ["string", "null"], "maxLength": 200 },
          "contact_id": { "type": ["string", "null"], "maxLength": 200 },
          "channel": { "enum": ["call", "email", "text", "meeting", "note", null] },
          "summary": { "type": ["string", "null"], "maxLength": 5000 },
          "next_action": { "type": ["string", "null"], "maxLength": 500 },
          "next_follow_up_at": { "type": ["string", "null"], "maxLength": 10 },
          "notes": { "type": ["string", "null"], "maxLength": 5000 },
          "stage": {
            "enum": [
              "reach_out",
              "keep_warm",
              "interested",
              "call_scheduled",
              "pitched",
              "discovery_ready",
              "discovery_booked",
              "proposal",
              "client",
              "lost",
              "parked",
              null
            ]
          },
          "content": { "type": ["string", "null"], "maxLength": 5000 },
          "suggestion_kind": { "enum": ["create_task", "attention_nudge", null] },
          "description": { "type": ["string", "null"], "maxLength": 5000 },
          "reason": { "type": ["string", "null"], "maxLength": 2000 },
          "due_date": { "type": ["string", "null"], "maxLength": 10 },
          "claim_key": { "type": ["string", "null"], "maxLength": 300 }
        }
      }
    }
  }
}
