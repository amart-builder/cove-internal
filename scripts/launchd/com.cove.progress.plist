<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cove.progress</string>
  <key>ProgramArguments</key>
  <array>
    <string>__COVE_NODE_REAL__</string>
    <string>/Users/operator/Atlas/Projects/astack/cove/scripts/cove-progress-reconcile.mjs</string>
    <string>--once</string>
  </array>
  <!-- /Users/operator/Atlas/Projects/astack/cove is a placeholder layout.
       install-cove-local.sh rewrites every absolute repo/data/workspace/home
       path for the machine it runs on. Edit by hand only if you install this
       agent without that script. -->
  <key>WorkingDirectory</key>
  <string>/Users/operator/Atlas/Projects/astack/cove</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/operator</string>
    <key>PATH</key>
