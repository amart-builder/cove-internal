    <string>/Users/operator/Atlas</string>
  </dict>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/operator/Library/Logs/cove-progress-reconcile.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/operator/Library/Logs/cove-progress-reconcile.log</string>
</dict>
</plist>
